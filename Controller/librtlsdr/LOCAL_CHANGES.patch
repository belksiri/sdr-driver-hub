+/* Phase 2 (RTL-SDR Android) — open from a pre-authorised USB file descriptor
+ * (from Android UsbDeviceConnection). No device enumeration is possible on a
+ * non-rooted device, so wrap the fd via libusb_wrap_sys_device after disabling
+ * device discovery, then run the shared init. */
+int rtlsdr_open_fd(rtlsdr_dev_t **out_dev, int fd)
+{
+	int r;
+	rtlsdr_dev_t *dev = NULL;
+
+	dev = malloc(sizeof(rtlsdr_dev_t));
+	if (NULL == dev)
+		return -ENOMEM;
+
+	memset(dev, 0, sizeof(rtlsdr_dev_t));
+	memcpy(dev->fir, fir_default, sizeof(fir_default));
+
+	libusb_set_option(NULL, LIBUSB_OPTION_NO_DEVICE_DISCOVERY);
+	r = libusb_init(&dev->ctx);
+	if (r < 0) {
+		free(dev);
+		return -1;
+	}
+
+	dev->dev_lost = 1;
+
+	r = libusb_wrap_sys_device(dev->ctx, (intptr_t) fd, &dev->devh);
+	if (r < 0 || NULL == dev->devh) {
+		libusb_exit(dev->ctx);
+		free(dev);
+		return -1;
+	}
+
+	return rtlsdr_finish_open(dev, out_dev);
+}
 
