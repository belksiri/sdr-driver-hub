<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Builds de développement (profil DriverKit de l'équipe : idVendor « * »).
	     Le matching réel est restreint par IOKitPersonalities (0x0BDA:0x2838 /
	     0x0BDA:0x2832). L'archive App Store utilise
	     BelksiriRtlSdrDriver.AppStore.entitlements. -->
	<key>com.apple.developer.driverkit</key>
	<true/>
	<key>com.apple.developer.driverkit.transport.usb</key>
	<array>
		<dict>
			<key>idVendor</key>
			<string>*</string>
		</dict>
	</array>
</dict>
</plist>
